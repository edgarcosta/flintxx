# Makefile.in for flintxx - a C++ wrapper for FLINT
# This is a header-only library

# Installation directories
prefix = @prefix@
exec_prefix = @exec_prefix@
libdir = @libdir@
includedir = @includedir@
bindir = @bindir@

# Compiler and flags
CXX = @CXX@
CXXFLAGS = @CXXFLAGS@ -std=c++17
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@

# Source directories
SRCDIR = src
TESTDIR = test
EXAMPLEDIR = examples

# Header files (all .h files in src/)
HEADERS = $(wildcard $(SRCDIR)/*.h) $(wildcard $(SRCDIR)/flintxx/*.h)

# Test executables (following FLINT pattern)
TEST_BASIC = $(TESTDIR)/test_basic
TEST_COMPREHENSIVE = $(TESTDIR)/test_comprehensive  
TEST_VECTORS_SIMPLE = $(TESTDIR)/test_vectors_simple

# All working tests
TESTS = $(TEST_BASIC) $(TEST_COMPREHENSIVE) $(TEST_VECTORS_SIMPLE)

# Example source files
EXAMPLE_SOURCES = $(wildcard $(EXAMPLEDIR)/*.cpp)
EXAMPLE_TARGETS = $(EXAMPLE_SOURCES:.cpp=)

# Default target
all: tests

# Header-only library - no compilation needed for the library itself
# Just ensure headers are properly structured
headers: $(HEADERS)
	@echo "Header-only library ready"

# Build all tests (following FLINT pattern)
tests: $(TESTS)

# Individual test targets (following FLINT naming)
$(TEST_BASIC): $(TESTDIR)/test_basic.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -I$(SRCDIR) $< -o $@ $(LDFLAGS) $(LIBS)

$(TEST_COMPREHENSIVE): $(TESTDIR)/test_comprehensive.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -I$(SRCDIR) $< -o $@ $(LDFLAGS) $(LIBS)

$(TEST_VECTORS_SIMPLE): $(TESTDIR)/test_vectors_simple.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -I$(SRCDIR) $< -o $@ $(LDFLAGS) $(LIBS)

# Examples  
examples: $(EXAMPLE_TARGETS)

$(EXAMPLEDIR)/%: $(EXAMPLEDIR)/%.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -I$(SRCDIR) $< -o $@ $(LDFLAGS) $(LIBS)

# Test running pattern (following FLINT)
%_TEST_RUN: %
	@$<

# Run all tests (following FLINT pattern)
check: tests $(TESTS:%=%_TEST_RUN)
	@echo ''
	@echo 'All tests passed.'

# Install headers
install: $(HEADERS)
	mkdir -p $(DESTDIR)$(includedir)/flintxx
	cp -r $(SRCDIR)/*.h $(DESTDIR)$(includedir)/
	cp -r $(SRCDIR)/flintxx/*.h $(DESTDIR)$(includedir)/flintxx/

# Uninstall
uninstall:
	rm -rf $(DESTDIR)$(includedir)/flintxx
	rm -f $(DESTDIR)$(includedir)/*xx.h

# Clean
clean:
	rm -f $(TESTS)
	rm -f $(EXAMPLE_TARGETS)
	rm -f *~ $(SRCDIR)/*~ $(TESTDIR)/*~ $(EXAMPLEDIR)/*~

distclean: clean
	rm -f Makefile config.status config.log src/flint-config.h
	rm -rf autom4te.cache

# Maintainer clean
maintainer-clean: distclean
	rm -f configure src/flint-config.h.in

# Create distribution tarball
dist:
	@echo "Creating distribution tarball..."
	@version=$$(cat VERSION); \
	tarname="flintxx-$$version"; \
	mkdir -p "$$tarname"; \
	cp -r src test examples configure.ac Makefile.in VERSION AUTHORS README.md "$$tarname/"; \
	tar -czf "$$tarname.tar.gz" "$$tarname"; \
	rm -rf "$$tarname"; \
	echo "Created $$tarname.tar.gz"

# Help
help:
	@echo "Available targets:"
	@echo "  all         - Build tests (default)"
	@echo "  headers     - Verify headers are ready (header-only library)"
	@echo "  tests       - Build all tests"
	@echo "  examples    - Build all examples"
	@echo "  check       - Build and run all tests"
	@echo "  install     - Install headers"
	@echo "  uninstall   - Remove installed headers"
	@echo "  clean       - Remove built files"
	@echo "  distclean   - Remove all generated files"
	@echo "  dist        - Create distribution tarball"
	@echo "  help        - Show this help"
	@echo ""
	@echo "Individual test targets:"
	@echo "  $(TEST_BASIC)"
	@echo "  $(TEST_COMPREHENSIVE)"
	@echo "  $(TEST_VECTORS_SIMPLE)"

.PHONY: all headers tests examples check install uninstall clean distclean maintainer-clean dist help 