@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(GMP REQUIRED)
find_dependency(MPFR REQUIRED)
find_dependency(Threads REQUIRED)

if(@WITH_NTL@)
    find_dependency(NTL REQUIRED)
endif()

if(@FLINT_USES_BLAS@)
    find_dependency(CBLAS)
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/flintxxTargets.cmake")

# Set variables for compatibility
set(FLINTXX_LIBRARIES flintxx)
set(FLINTXX_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@") 